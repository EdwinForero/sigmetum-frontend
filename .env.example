# Backend API URL
VITE_BASE_URL=http://localhost:8000

# API version prefix (must match backend configuration)
VITE_API_PREFIX=/api/v1

# S3 bucket or CloudFront base URL (for direct public assets)
VITE_S3_URL=https://<dominio-de-tus-recursos-estaticos>

# Comma-separated S3 image keys for the home carousel (leave empty to use placeholders)
VITE_CAROUSEL_IMAGE_KEYS=gallery/photo1.jpg,gallery/photo2.jpg,gallery/photo3.jpg
