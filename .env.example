# Backend API URL
VITE_BASE_URL=http://localhost:8000

# API version prefix (must match backend configuration)
VITE_API_PREFIX=/api/v1

# S3 bucket or CloudFront base URL (for direct public assets)
# Also used at build time to compile the favicon into index.html (ASSETS.LOGO); if empty (or not starting with https://), there is no favicon
VITE_S3_URL=https://<dominio-de-tus-recursos-estaticos>

# Comma-separated S3 image keys for the home carousel (leave empty to use placeholders)
VITE_CAROUSEL_IMAGE_KEYS=gallery/photo1.jpg,gallery/photo2.jpg,gallery/photo3.jpg

# Cognito user pool ID, <region>_<pool-id>: its prefix is the region used to build the cognito-idp endpoint (public value; only defined on the Amplify branch, so login cannot be tried locally)
VITE_COGNITO_USER_POOL_ID=<region>_<id-del-pool>

# Cognito public app client ID, used for the SRP login and the token refresh (public value, no secret; only defined on the Amplify branch)
VITE_COGNITO_CLIENT_ID=<id-del-cliente-publico>
