# Backend API URL
REACT_APP_BASE_URL=http://localhost:8000

# S3 bucket or CloudFront base URL (for direct public assets)
REACT_APP_S3_URL=https://your-bucket.s3.eu-west-3.amazonaws.com

# Comma-separated S3 image keys for the home carousel (leave empty to use placeholders)
REACT_APP_CAROUSEL_IMAGE_KEYS=photo1.jpg,photo2.jpg,photo3.jpg
