    "understand-anything@understand-anything": true,
    "humanizer@humanizer": true
  },
  "autoMemoryEnabled": false,
  "permissions": {
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git add *)",
      "PowerShell(git stash *)"
    ]
  }
}
